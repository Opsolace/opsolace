# Resend API key - https://resend.com/api-keys
# Put real values in .env.local (gitignored), NOT in this file - this one is committed.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender. Must be on a domain verified in Resend.
# Use "Opsolace <onboarding@resend.dev>" to test before the domain is verified.
CONTACT_FROM_EMAIL="Opsolace <hello@opsolace.com>"

# Where enquiries land.
CONTACT_TO_EMAIL=hello.opsolace@outlook.com
